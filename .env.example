# Development only. Copy to .env for Docker Compose. Never commit .env.
DEBUG=1
SECRET_KEY=local-development-only-change-before-deployment-123456789
POSTGRES_DB=exam_portal
POSTGRES_USER=exam_portal
POSTGRES_PASSWORD=local-db-only-change-before-deployment
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Default writes reset links to backend/.dev-emails locally; use SMTP for deployment.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=exams@example.test
TRUST_PROXY=0
# For optional Caddy TLS profile, use a real DNS name pointing at the host.
DOMAIN=localhost
